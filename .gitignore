# dsh runtime 打包产物(由 npm run package:dsh-runtime 生成;M4 退役 src-tauri
# 之后从 src-tauri/binaries/ 挪到仓库根,provisioning 与冒烟都指到这里)
dsh-runtime/
# 数据库本地数据(开发用)
*.db
*.db-journal
*.sqlite
*.sqlite-journal
data/local/

# 用户资产与配置(不要提交)
assets.local.json
config.local.toml

# Python 虚拟环境(e2e 测试服务器依赖)
test-sftp/.venv/
test-sftp/__pycache__/
# 测试 SSH/SFTP 服务器的持久 host key(本地生成的测试私钥,不入库)
test-sftp/host_key.pem
# exec_server.py 的 SFTP 根目录(服务器首启自动创建并写入 hello.txt)
test-sftp/sftp-root/
# 验收脚本跑出来的审计存储(默认落在 cwd;本地产物,不入库)
starhub-audit.json
