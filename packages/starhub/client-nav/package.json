{
  "name": "@deepseek-ai/dsh-starhub-client-nav",
  "description": "StarHub shell navigation: sidebar.navigation primary section rows plus a shell.overlay full-frame iframe layer embedding the StarHub frontend same-origin (StarHub-local package, not upstream)",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "^2.1.1",
    "zmodem.js": "0.1.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
