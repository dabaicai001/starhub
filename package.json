{
  "name": "starhub",
  "version": "0.142.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:lib": "tsc -b tsconfig.host.json",
    "build:lib:client": "tsc -b tsconfig.client.json && node scripts/build-client-bundle.mjs",
    "build:window": "node scripts/build-window.mjs",
    "clean:lib": "node scripts/clean-lib.mjs",
    "test:ai-context": "node --test tests/ai-context.test.mjs",
    "test:ai-scroll": "node --test tests/ai-scroll-position.test.mjs",
    "test:ai-steering": "node --test tests/ai-steering.test.mjs",
    "test:ssh-prompt": "node --test tests/ssh-prompt-capture.test.mjs",
    "test:terminal-cwd": "node --test tests/terminal-cwd.test.mjs",
    "sidecar-rust:build": "node scripts/cargo-sidecar.mjs build",
    "sidecar-rust:build:release": "node scripts/cargo-sidecar.mjs build --release",
    "sidecar-rust:test": "node scripts/cargo-sidecar.mjs test",
    "verify:bridge-compat": "tsx test-sftp/verify_bridge_compat.mjs",
    "verify:ai-cancel": "tsx test-sftp/verify_ai_cancel.mjs",
    "test:ssh-bg": "node --test tests/ssh-background-task.test.mjs",
    "test:utils": "node --test tests/utils/crypto.test.mjs tests/utils/ddlGenerator.test.mjs tests/utils/sqlHistory.test.mjs tests/utils/commandGuard.test.mjs tests/utils/sqlTables.test.mjs tests/utils/xshellQuickCommand.test.mjs tests/utils/aiMention.test.mjs tests/utils/aiCompaction.test.mjs",
    "version": "node scripts/bump-version.mjs",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "sidecar:build:release": "node scripts/build-sidecar.mjs --release",
    "build:web": "pnpm --dir vendor/deepseek-harness run build:web",
    "verify:web-dist": "node scripts/verify-web-dist.mjs",
    "package:dsh-runtime": "pnpm --dir vendor/deepseek-harness exec tsx scripts/package-dsh-runtime.ts",
    "provision:dsh": "node scripts/provision-dsh.mjs",
    "plugin:bundle": "node scripts/build-plugin-bundle.mjs",
    "plugin:pack": "node scripts/build-plugin-bundle.mjs --pack",
    "plugin:publish": "node scripts/publish-plugin-bundle.mjs",
    "smoke:plugin-bundle": "node scripts/smoke-plugin-bundle.mjs",
    "smoke:dsh-desktop": "node scripts/smoke-dsh-desktop.mjs",
    "test:provision": "node --test tests/provision-dsh.test.mjs",
    "test:plugin-bundle": "node --test tests/plugin-bundle.test.mjs",
    "test:workflows": "node --test tests/workflows-yaml.test.mjs",
    "migrate:tauri-data": "node scripts/migrate-tauri-data.mjs",
    "test:migrate": "node --test tests/migrate-tauri-data.test.mjs",
    "test:starhub": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.0",
    "js-yaml": "^4.3.2",
    "jsdom": "29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
