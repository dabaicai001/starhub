  "private": true,
  "type": "module",
  "scripts": {
    "build:window": "node scripts/build-window.mjs",
    "test:ai-context": "node --test tests/ai-context.test.mjs",
    "test:ai-scroll": "node --test tests/ai-scroll-position.test.mjs",
    "test:ai-steering": "node --test tests/ai-steering.test.mjs",
    "test:ssh-prompt": "node --test tests/ssh-prompt-capture.test.mjs",
    "test:terminal-cwd": "node --test tests/terminal-cwd.test.mjs",
    "sidecar-rust:build": "node scripts/cargo-sidecar.mjs build",
    "sidecar-rust:build:release": "node scripts/cargo-sidecar.mjs build --release",
    "sidecar-rust:test": "node scripts/cargo-sidecar.mjs test",
    "verify:bridge-compat": "pnpm --dir vendor/deepseek-harness exec tsx ../../test-sftp/verify_bridge_compat.mjs",
    "test:ssh-bg": "node --test tests/ssh-background-task.test.mjs",
    "test:utils": "node --test tests/utils/crypto.test.mjs tests/utils/ddlGenerator.test.mjs tests/utils/sqlHistory.test.mjs tests/utils/commandGuard.test.mjs tests/utils/sqlTables.test.mjs tests/utils/xshellQuickCommand.test.mjs tests/utils/aiMention.test.mjs tests/utils/aiCompaction.test.mjs",
    "version": "node scripts/bump-version.mjs",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "sidecar:build:release": "node scripts/build-sidecar.mjs --release",
    "clean:vendor-starhub": "node scripts/clean-vendor-starhub.mjs",
